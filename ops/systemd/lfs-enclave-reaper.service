[Unit]
Description=Enclave of the 16 F-120 Stalled-Session Reaper & Local Ollama Feedback Resolver
After=network-online.target aegis-ollama.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/LFS-Suite/3-lfs-aegis-linux/capsules/enclave-digital-twin
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/lfs-aegis/jules.env
Environment=LFS_ENCLAVE_RUNTIME_CONFIG=1
ExecStart=/usr/bin/python3 %h/Projects/LFS-Suite/3-lfs-aegis-linux/capsules/enclave-digital-twin/tools/enclave_fleet_ctl.py --reap
TimeoutStartSec=300
Slice=background.slice
Nice=15
CPUWeight=20
IOWeight=20
IOSchedulingClass=idle
MemoryHigh=512M
MemoryMax=1G
OOMScoreAdjust=300
