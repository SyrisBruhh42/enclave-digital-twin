[Unit]
Description=Enclave of the 16 Jules Factory Wave Tick (36 Waves / 24h, Standby-Gated)
After=network-online.target aegis-ollama.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/LFS-Suite/3-lfs-aegis-linux/capsules/enclave-digital-twin
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/lfs-aegis/jules.env
Environment=LFS_JULES_GATEWAY_URL=http://127.0.0.1:9445
ExecStart=/usr/bin/python3 %h/Projects/LFS-Suite/3-lfs-aegis-linux/capsules/enclave-digital-twin/tools/enclave_fleet_ctl.py --tick
TimeoutStartSec=600
Slice=background.slice
Nice=15
CPUWeight=20
IOWeight=20
IOSchedulingClass=idle
MemoryHigh=1G
MemoryMax=2G
OOMScoreAdjust=300
