; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Enclave of the 16 — Pokémon Emerald Overworld"
config/description="Gen-3 Pokémon Emerald (Hoenn) top-down pixel-art overworld for Willow and The Enclave of the 16."
config/version="2.0.0"
run/main_scene="res://scenes/emerald_overworld.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

window/size/viewport_width=480
window/size/viewport_height=320
window/size/window_width_override=1440
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom="res://aegis_lds_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
