  "$defs": {
    "ContextManifest10Block": {
      "type": "object",
      "required": [
        "active_pov_id",
        "next_pov_target",
        "full_cards_loaded_count",
        "loaded_full_card_ids",
        "interlocutor_full_cards_loaded",
        "leaked_interlocutor_private_cards",
        "total_tokens",
        "max_tokens",
        "blocks"
      ],
      "properties": {
        "active_pov_id": {
          "type": "string",
          "pattern": "^enclave_(0[1-9]|1[0-6])_[a-z]+$"
        },
        "next_pov_target": {
          "type": "string",
          "pattern": "^enclave_(0[1-9]|1[0-6])_[a-z]+$"
        },
        "full_cards_loaded_count": { "type": "integer", "const": 1 },
        "loaded_full_card_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "type": "string" }
        },
        "interlocutor_full_cards_loaded": { "type": "integer", "const": 0 },
        "leaked_interlocutor_private_cards": { "type": "boolean", "const": false },
        "total_tokens": { "type": "integer", "minimum": 1, "maximum": 3500 },
        "max_tokens": { "type": "integer", "minimum": 1, "maximum": 3500 },
        "blocks": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["block_index", "block_id", "tokens", "cap_tokens"],
            "properties": {
              "block_index": { "type": "integer", "minimum": 1, "maximum": 10 },
              "block_id": { "type": "string" },
              "tokens": { "type": "integer", "minimum": 0 },
              "cap_tokens": { "type": "integer", "minimum": 1, "maximum": 3500 }
            }
          }
        }
      }
    },
    "DriftAuditReceipt": {
      "type": "object",
      "required": [
        "character_id",
        "sample_count",
        "drift_alert",
        "law_l16_compliant",
        "drifted_axes",
        "max_abs_z",
        "re_anchor_ticks",
        "corrective_authors_note"
      ],
      "properties": {
        "character_id": {
          "type": "string",
          "pattern": "^enclave_(0[1-9]|1[0-6])_[a-z]+$"
        },
        "sample_count": { "type": "integer", "minimum": 0 },
        "drift_alert": { "type": "boolean" },
        "law_l16_compliant": { "type": "boolean" },
        "drifted_axes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "max_abs_z": { "type": "number", "minimum": 0.0 },
        "re_anchor_ticks": { "type": "integer", "enum": [0, 3] },
        "corrective_authors_note": { "type": "string" }
      }
    },
    "WillowAcActionReceipt": {
      "type": "object",
      "required": [
        "ok",
        "action_type",
        "rup_earned",
        "feed_entry",
        "summary"
      ],
      "properties": {
        "ok": { "type": "boolean", "const": true },
        "action_type": {
          "type": "string",
          "enum": [
            "forage_dig",
            "catch_critter",
            "catch_fish",
            "water_crop",
            "craft_diy",
            "place_decor",
            "gift_citizen",
            "complete_daily_favor",
            "donate_museum",
            "trigger_catalyst"
          ]
        },
        "rup_earned": { "type": "integer", "minimum": 0 },
        "feed_entry": {
          "type": "object",
          "required": [
            "feed_id",
            "sol",
            "day_phase",
            "category",
            "title",
            "summary",
            "actors",
            "lethality"
          ],
          "properties": {
            "feed_id": { "type": "string" },
            "sol": { "type": "integer", "minimum": 1 },
            "day_phase": {
              "type": "string",
              "enum": ["DAWN_SHIFT", "MIDDAY_EXPEDITION", "DUSK_CRAFT", "THE_FEAST"]
            },
            "category": { "type": "string" },
            "title": { "type": "string" },
            "summary": { "type": "string" },
            "actors": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^enclave_(0[1-9]|1[0-6])_[a-z]+$"
              }
            },
            "lethality": { "type": "integer", "const": 0 }
          }
        },
        "summary": { "type": "object" }
      }
    },
    "ShadowPrankTriad": {
      "type": "object",
      "required": [
        "prank_id",
        "event_type",
        "origin_sol",
        "maturity_sol",
        "lethality",
        "node_a",
        "node_b",
        "node_c",
        "target_b_missed",
        "blamed_node"
      ],
      "properties": {
        "prank_id": { "type": "string" },
        "event_type": {
          "type": "string",
          "enum": ["SHADOW_ECONOMY_PRANK_SEEDED", "SHADOW_ECONOMY_PRANK_MATURED"]
        },
        "origin_sol": { "type": "integer", "minimum": 1 },
        "maturity_sol": { "type": "integer", "minimum": 4 },
        "lethality": { "type": "integer", "const": 0 },
        "node_a": { "type": "string", "pattern": "^enclave_(0[1-9]|1[0-6])_[a-z]+$" },
        "node_b": { "type": "string", "pattern": "^enclave_(0[1-9]|1[0-6])_[a-z]+$" },
        "node_c": { "type": "string", "pattern": "^enclave_(0[1-9]|1[0-6])_[a-z]+$" },
        "target_b_missed": { "type": "boolean", "const": true },
        "blamed_node": { "type": "string", "pattern": "^enclave_(0[1-9]|1[0-6])_[a-z]+$" }
      }
    }
  }
}
